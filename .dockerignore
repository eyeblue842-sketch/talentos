node_modules
**/node_modules
frontend/node_modules
backend/node_modules
frontend/.next
backend/storage/resumes/*
!backend/storage/resumes/.gitkeep
.git
coverage
backend-dev.log
backend-dev.err.log
frontend-dev.log
frontend-dev.err.log
.env
.env.local
frontend/.env.local

# The document-processor is built from its own context (./document-processor) and
# is never needed inside the backend/frontend images. Its Python venv + docling/
# paddleocr model caches are hundreds of MB and were bloating the build context.
document-processor

# Misc heavy / generated artifacts that never belong in an image build context.
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.venv
**/.turbo
**/dist
**/*.log
.vscode
.idea
