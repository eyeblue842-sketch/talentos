{
  "name": "careeriz-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "worker:dev": "nodemon src/worker.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "ai:health": "node scripts/ai-health-check.js",
    "ai:enable-local-features": "node scripts/enable-local-ai-features.js",
    "build": "node -e \"console.log('backend build ready')\"",
    "lint": "eslint .",
    "test": "node --import ./env-bootstrap.js --test",
    "test:integration": "node ./scripts/run-with-test-db.js node --import ./env-bootstrap.js --test",
    "type-check": "tsc --project tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:test:status": "node ./scripts/run-with-test-db.js npx prisma migrate status --schema prisma/schema.prisma",
    "db:test:migrate": "node ./scripts/run-with-test-db.js npx prisma migrate deploy --schema prisma/schema.prisma",
    "db:test:reset": "node ./scripts/run-with-test-db.js npx prisma migrate reset --force --skip-generate --skip-seed --schema prisma/schema.prisma",
    "seed": "node prisma/seed.js",
    "seed:test-admin": "node scripts/seed-test-admin.js",
    "catalogue:sync": "node scripts/sync-product-catalogue.js"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1094.0",
    "@aws-sdk/client-s3": "^3.872.0",
    "@aws-sdk/client-sqs": "^3.1094.0",
    "@aws-sdk/s3-request-presigner": "^3.1094.0",
    "@careeriz/shared": "file:../shared",
    "@elastic/elasticsearch": "^8.15.0",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "file-type": "^22.0.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.5",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.15.1",
    "razorpay": "^2.9.8",
    "redis": "^6.1.0",
    "slugify": "^1.6.6",
    "yauzl": "^3.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.7.0",
    "nodemon": "^3.1.9",
    "prisma": "^6.5.0",
    "supertest": "^7.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  }
}
