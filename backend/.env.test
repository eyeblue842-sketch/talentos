# This file is tracked in git - it must never hold a real, working database
# credential. Real values belong only in a private, git-ignored
# backend/.env.test.local (see docs/backend-test-database.md), or in your
# shell/CI's own environment variables. env-bootstrap.js refuses to start
# the test suite while these placeholders are still in effect.
TEST_DATABASE_URL=REPLACE_WITH_LOCAL_TEST_DATABASE_URL
TEST_DIRECT_URL=REPLACE_WITH_LOCAL_TEST_DIRECT_URL

# Deterministic dummy secrets for billing unit tests only (HMAC signature
# math) - never real Razorpay credentials, RAZORPAY_ENABLED stays unset/false
# so no live Razorpay API calls are ever attempted in tests.
RAZORPAY_KEY_SECRET=test_only_razorpay_key_secret_do_not_use
RAZORPAY_WEBHOOK_SECRET=test_only_razorpay_webhook_secret_do_not_use
