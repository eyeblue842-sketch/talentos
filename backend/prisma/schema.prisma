generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  RECRUITER
  CANDIDATE
}

enum OrganisationStatus {
  ACTIVE
  INACTIVE
}

enum OrganisationRole {
  OWNER
  ADMIN
  RECRUITER
  HIRING_MANAGER
  INTERVIEWER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum OrganisationInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ON_HOLD
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum WorkplaceType {
  ONSITE
  REMOTE
  HYBRID
}

enum CandidateTag {
  SHORTLISTED
  REJECTED
  HOLD
}

enum PipelineStage {
  APPLIED
  SHORTLISTED
  INTERVIEW_SCHEDULED
  SELECTED
  REJECTED
  WITHDRAWN
}

enum AvailabilityStatus {
  IMMEDIATE
  TWO_WEEKS
  ONE_MONTH
  NOT_LOOKING
}

enum ProfileVisibility {
  PRIVATE
  RECRUITERS_ONLY
  PUBLIC
}

enum AuthTokenType {
  PASSWORD_RESET
  PASSWORD_RESET_SESSION
  EMAIL_VERIFICATION
  OAUTH_STATE
  OAUTH_HANDOFF
}

enum RequisitionPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RequisitionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  OPEN
  ON_HOLD
  CLOSED
  CANCELLED
}

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum InterviewType {
  SCREENING
  TECHNICAL
  MANAGERIAL
  HR
  PANEL
  TAKE_HOME
  OTHER
}

enum InterviewStatus {
  PLANNED
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULE_REQUIRED
}

enum FeedbackRecommendation {
  STRONG_HIRE
  HIRE
  HOLD
  NO_HIRE
  STRONG_NO_HIRE
}

enum NotificationType {
  ORGANISATION
  MEMBERSHIP
  REQUISITION
  JOB
  APPLICATION
  INTERVIEW
  FEEDBACK
  SYSTEM
}

enum JobVisibility {
  EXTERNAL
  INTERNAL
  BOTH
}

enum ScreeningQuestionType {
  YES_NO
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  CURRENCY
  DATE
  EMAIL
  PHONE
  URL
  SINGLE_SELECT
  MULTI_SELECT
  FILE_UPLOAD
}

enum ScreeningRuleOperator {
  EQUALS
  NOT_EQUALS
  LESS_THAN
  LESS_THAN_OR_EQUAL
  GREATER_THAN
  GREATER_THAN_OR_EQUAL
  CONTAINS
  DOES_NOT_CONTAIN
  IN
  NOT_IN
}

enum ScreeningOutcome {
  MEETS_CRITERIA
  REVIEW_REQUIRED
  DOES_NOT_MEET_CRITERIA
}

enum ApplicationSourceType {
  CAREER_PAGE
  JOB_BOARD
  REFERRAL
  DIRECT_LINK
  INTERNAL_PORTAL
  API
  UNKNOWN
}

enum ResumeAssetKind {
  RESUME
  SCREENING_FILE
}

enum JobAlertFrequency {
  IMMEDIATE
  DAILY
  WEEKLY
  DISABLED
}

enum CandidateActivityType {
  PROFILE_UPDATED
  RESUME_UPLOADED
  JOB_VIEWED
  JOB_SAVED
  JOB_UNSAVED
  APPLICATION_SUBMITTED
  APPLICATION_WITHDRAWN
  NOTIFICATION_OPENED
  RECENT_HISTORY_CLEARED
  PREFERENCES_UPDATED
}

enum RecruiterSavedSearchType {
  SAVED
  RECENT
}

model User {
  id                         String                      @id @default(cuid())
  email                      String                      @unique
  passwordHash               String
  role                       UserRole
  isActive                   Boolean                     @default(true)
  sessionVersion             Int                         @default(0)
  emailVerifiedAt            DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  recruiterProfile           RecruiterProfile?
  candidateProfile           CandidateProfile?
  jobs                       Job[]                       @relation("PostedJobs")
  notes                      AtsNote[]                   @relation("NoteAuthor")
  applicationActivities      ApplicationActivity[]
  authTokens                 AuthToken[]
  memberships                OrganisationMembership[]
  createdRequisitions        JobRequisition[]            @relation("RequisitionCreatedBy")
  approvedRequisitions       JobRequisition[]            @relation("RequisitionApprovedBy")
  managedRequisitions        JobRequisition[]            @relation("RequisitionHiringManager")
  recruitedRequisitions      JobRequisition[]            @relation("RequisitionRecruiter")
  managedJobs                Job[]                       @relation("JobHiringManager")
  interviewPlanCreators      InterviewProcess[]          @relation("InterviewPlanCreatedBy")
  interviewPanelMemberships  InterviewPanelMember[]
  interviewFeedbacks         InterviewFeedback[]         @relation("InterviewFeedbackAuthor")
  notifications              Notification[]              @relation("NotificationRecipient")
  auditLogs                  AuditLog[]                  @relation("AuditLogActor")
  screeningQuestionTemplates ScreeningQuestionTemplate[] @relation("ScreeningQuestionTemplateAuthor")
  jobScreeningQuestions      JobScreeningQuestion[]      @relation("JobScreeningQuestionAuthor")
  resumeAssets               ResumeAsset[]               @relation("ResumeAssetOwner")
  sentOrganisationInvites    OrganisationInvitation[]    @relation("OrganisationInvitationInvitedBy")
  acceptedOrganisationInvites OrganisationInvitation[]   @relation("OrganisationInvitationAcceptedBy")
}

model Organisation {
  id                         String                       @id @default(cuid())
  name                       String
  slug                       String                       @unique
  status                     OrganisationStatus           @default(ACTIVE)
  website                    String?
  logoUrl                    String?
  publicDescription          String?
  industry                   String?
  organisationSize           String?
  headquarters               String?
  publicLocations            String[]                     @default([])
  cultureSummary             String?
  benefitsSummary            String?
  careersEnabled             Boolean                      @default(true)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  recruiterProfiles          RecruiterProfile[]
  memberships                OrganisationMembership[]
  jobs                       Job[]
  applications               Application[]
  notes                      AtsNote[]
  activities                 ApplicationActivity[]
  savedCandidates            SavedCandidate[]
  recruiterSavedSearches     RecruiterSavedSearch[]
  talentPools                TalentPool[]
  requisitions               JobRequisition[]
  interviewPlans             InterviewProcess[]
  interviewRounds            InterviewRound[]
  interviewPanels            InterviewPanelMember[]
  interviewFeedbacks         InterviewFeedback[]
  notifications              Notification[]
  auditLogs                  AuditLog[]
  screeningQuestionTemplates ScreeningQuestionTemplate[]
  jobScreeningQuestions      JobScreeningQuestion[]
  applicationsSubmitted      JobApplication[]
  applicationFlags           ApplicationFlag[]
  applicationAnswers         ApplicationScreeningAnswer[]
  applicationResumeSnapshots ApplicationResumeSnapshot[]
  applicationTimelines       ApplicationTimeline[]
  invitations                OrganisationInvitation[]

  @@index([status])
}

model OrganisationMembership {
  id             String           @id @default(cuid())
  organisationId String
  userId         String
  role           OrganisationRole
  status         MembershipStatus @default(ACTIVE)
  invitedById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@index([userId, status])
  @@index([organisationId, role, status])
}

model OrganisationInvitation {
  id               String                       @id @default(cuid())
  organisationId   String
  email            String
  role             OrganisationRole
  tokenHash        String                       @unique
  status           OrganisationInvitationStatus @default(PENDING)
  expiresAt        DateTime
  invitedByUserId  String
  acceptedByUserId String?
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  organisation     Organisation                 @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invitedByUser    User                         @relation("OrganisationInvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedByUser   User?                        @relation("OrganisationInvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, status, expiresAt])
  @@index([email, status, expiresAt])
  @@index([organisationId, email])
}

model RecruiterProfile {
  id                   String           @id @default(cuid())
  userId               String           @unique
  organisationId       String?
  companyEmailDomain   String
  companyName          String?
  aboutCompany         String?
  industryDomain       String?
  companyType          String?
  headquartersLocation String?
  startedYear          Int?
  employeeCount        Int?
  branchCount          Int?
  officeLocations      String[]
  annualTurnover       String?
  designation          String?
  workingSince         Int?
  companySize          String?
  website              String?
  profileCompleted     Boolean          @default(false)
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation         Organisation?    @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  savedProfiles        SavedCandidate[]
  savedSearches        RecruiterSavedSearch[]
  createdTalentPools   TalentPool[]

  @@index([organisationId])
}

model CandidateProfile {
  id                          String              @id @default(cuid())
  userId                      String              @unique
  fullName                    String
  headline                    String?
  currentTitle                String?
  location                    String?
  preferredLocations          String[]
  preferredRoles              String[]            @default([])
  totalExperience             Int                 @default(0)
  workplacePreferences        WorkplaceType[]     @default([])
  employmentPreferences       EmploymentType[]    @default([])
  currentCtcLpa               Int?
  expectedCtcLpa              Int?
  availability                AvailabilityStatus  @default(IMMEDIATE)
  noticePeriodDays            Int?
  skills                      String[]
  summary                     String?
  resumeUrl                   String?
  latestResumeAssetId         String?
  profileImageUrl             String?
  portfolioUrl                String?
  linkedInUrl                 String?
  githubUrl                   String?
  profileVisibility           ProfileVisibility   @default(PRIVATE)
  recommendationEnabled       Boolean             @default(true)
  notifyForSavedJobUpdates    Boolean             @default(true)
  notifyForRecommendations    Boolean             @default(true)
  notifyForInterviews         Boolean             @default(true)
  notifyForApplicationUpdates Boolean             @default(true)
  notifyForOffers             Boolean             @default(true)
  notifyForProfileReminders   Boolean             @default(true)
  notifyForMarketing          Boolean             @default(false)
  willingToRelocate           Boolean             @default(false)
  minExpectedSalary           Int?
  preferredCurrency           String?
  workAuthorization           String?
  requiresVisaSponsorship     Boolean             @default(false)
  preferredIndustries         String[]            @default([])
  preferredCompanySizes       String[]            @default([])
  travelWillingness           String?
  jobAlertEnabled             Boolean             @default(true)
  jobAlertFrequency           JobAlertFrequency   @default(WEEKLY)
  sharedResumeSlug            String?             @unique
  profileViews                Int                 @default(0)
  lastActiveAt                DateTime?
  updatedAt                   DateTime            @updatedAt
  user                        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications                Application[]
  submittedApplications       JobApplication[]
  resumeBuilder               ResumeBuilder?
  savedByRecruiters           SavedCandidate[]
  talentPoolMemberships       TalentPoolCandidate[]
  savedJobs                   SavedJob[]
  jobViews                    CandidateJobView[]
  activities                  CandidateActivity[]
  resumeAssets                ResumeAsset[]       @relation("CandidateResumeAssets")
  latestResumeAsset           ResumeAsset?        @relation("CandidateLatestResumeAsset", fields: [latestResumeAssetId], references: [id], onDelete: SetNull)

  @@index([recommendationEnabled, updatedAt])
}

model Job {
  id                    String                 @id @default(cuid())
  organisationId        String?
  recruiterId           String
  requisitionId         String?
  hiringManagerId       String?
  title                 String
  slug                  String                 @unique
  description           String
  skillsRequired        String[]
  experienceMin         Int
  experienceMax         Int
  salaryMin             Int?
  salaryMax             Int?
  currency              String?
  isPublic              Boolean                @default(false)
  publicSalaryEnabled   Boolean                @default(false)
  featuredInPortal      Boolean                @default(false)
  visibility            JobVisibility          @default(EXTERNAL)
  location              String
  employmentType        EmploymentType         @default(FULL_TIME)
  workplaceType         WorkplaceType?
  numberOfOpenings      Int                    @default(1)
  department            String?
  businessUnit          String?
  responsibilities      String[]               @default([])
  requirements          String[]               @default([])
  benefits              String[]               @default([])
  applicationDeadline   DateTime?
  applicationOpensAt    DateTime?
  applicationClosesAt   DateTime?
  maxApplications       Int?
  targetHires           Int?
  autoCloseOnTargetHire Boolean                @default(false)
  status                JobStatus              @default(OPEN)
  archivedAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  organisation          Organisation?          @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  recruiter             User                   @relation("PostedJobs", fields: [recruiterId], references: [id], onDelete: Cascade)
  hiringManager         User?                  @relation("JobHiringManager", fields: [hiringManagerId], references: [id], onDelete: SetNull)
  requisition           JobRequisition?        @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  applications          Application[]
  savedJobs             SavedJob[]
  candidateViews        CandidateJobView[]
  screeningQuestions    JobScreeningQuestion[]
  submittedApplications JobApplication[]

  @@index([organisationId, createdAt])
  @@index([organisationId, status])
  @@index([isPublic, status, createdAt])
  @@index([recruiterId])
  @@index([requisitionId])
  @@index([hiringManagerId])
  @@index([applicationDeadline])
  @@index([status, visibility, applicationOpensAt, applicationClosesAt])
}

model SavedJob {
  id                       String           @id @default(cuid())
  candidateId              String
  jobId                    String?
  organisationId           String?
  jobSlugSnapshot          String
  jobTitleSnapshot         String
  organisationNameSnapshot String
  createdAt                DateTime         @default(now())
  candidate                CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job                      Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@unique([candidateId, jobId])
  @@index([candidateId, createdAt])
  @@index([jobId])
  @@index([organisationId, createdAt])
}

model Application {
  id                   String                @id @default(cuid())
  organisationId       String?
  jobId                String
  candidateId          String
  currentStage         PipelineStage         @default(APPLIED)
  statusLabel          String                @default("Applied")
  coverLetter          String?
  recruiterTag         CandidateTag?
  appliedAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  interviewScheduledAt DateTime?
  interviewerName      String?
  recruiterNotes       String?
  matchScore           Int                   @default(0)
  organisation         Organisation?         @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  job                  Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate            CandidateProfile      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  notes                AtsNote[]
  activities           ApplicationActivity[]
  interviewProcesses   InterviewProcess[]
  submittedApplication JobApplication?

  @@unique([jobId, candidateId])
  @@index([organisationId, updatedAt])
  @@index([organisationId, currentStage])
}

model ScreeningQuestionTemplate {
  id                    String                 @id @default(cuid())
  organisationId        String
  createdById           String
  questionText          String
  internalLabel         String?
  helpText              String?
  placeholder           String?
  questionType          ScreeningQuestionType
  isRequiredByDefault   Boolean                @default(false)
  displayOrder          Int                    @default(0)
  isActive              Boolean                @default(true)
  config                Json?
  validationConfig      Json?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  organisation          Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy             User                   @relation("ScreeningQuestionTemplateAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  jobScreeningQuestions JobScreeningQuestion[]

  @@index([organisationId, isActive, updatedAt])
  @@index([organisationId, questionType, isActive])
}

model JobScreeningQuestion {
  id               String                       @id @default(cuid())
  organisationId   String
  jobId            String
  templateId       String?
  createdById      String
  questionText     String
  internalLabel    String?
  helpText         String?
  placeholder      String?
  questionType     ScreeningQuestionType
  required         Boolean                      @default(false)
  displayOrder     Int
  isActive         Boolean                      @default(true)
  config           Json?
  validationConfig Json?
  rules            Json?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  organisation     Organisation                 @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  job              Job                          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  template         ScreeningQuestionTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy        User                         @relation("JobScreeningQuestionAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  answers          ApplicationScreeningAnswer[]
  flags            ApplicationFlag[]

  @@index([organisationId, jobId, displayOrder])
  @@index([jobId, isActive, displayOrder])
  @@index([templateId])
}

model ResumeAsset {
  id                 String                       @id @default(cuid())
  candidateId        String
  ownerUserId        String
  kind               ResumeAssetKind              @default(RESUME)
  storageKey         String
  storageProvider    String
  originalFilename   String
  mimeType           String
  sizeBytes          Int
  createdAt          DateTime                     @default(now())
  candidate          CandidateProfile             @relation("CandidateResumeAssets", fields: [candidateId], references: [id], onDelete: Cascade)
  ownerUser          User                         @relation("ResumeAssetOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  resumeSnapshots    ApplicationResumeSnapshot[]
  answerFiles        ApplicationScreeningAnswer[] @relation("ScreeningAnswerFileAsset")
  latestForCandidate CandidateProfile[]           @relation("CandidateLatestResumeAsset")

  @@index([candidateId, kind, createdAt])
  @@index([ownerUserId, createdAt])
}

model JobApplication {
  id                       String                       @id @default(cuid())
  publicReference          String                       @unique
  organisationId           String
  jobId                    String
  candidateId              String
  applicationId            String?                      @unique
  resumeSnapshotId         String?
  sourceType               ApplicationSourceType        @default(UNKNOWN)
  sourceName               String?
  sourceCampaign           String?
  utmSource                String?
  utmMedium                String?
  utmCampaign              String?
  utmTerm                  String?
  utmContent               String?
  referrer                 String?
  directLinkIdentifier     String?
  screeningSummary         Json?
  candidateStatusUpdatedAt DateTime?
  withdrawnAt              DateTime?
  withdrawalReason         String?
  withdrawalNote           String?
  withdrawnByUserId        String?
  submittedAt              DateTime                     @default(now())
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  organisation             Organisation                 @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  job                      Job                          @relation(fields: [jobId], references: [id], onDelete: Restrict)
  candidate                CandidateProfile             @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  application              Application?                 @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  resumeSnapshot           ApplicationResumeSnapshot?
  answers                  ApplicationScreeningAnswer[]
  flags                    ApplicationFlag[]
  timeline                 ApplicationTimeline[]

  @@unique([jobId, candidateId])
  @@index([organisationId, submittedAt])
  @@index([organisationId, jobId, submittedAt])
  @@index([candidateId, submittedAt])
  @@index([candidateId, updatedAt])
  @@index([candidateId, withdrawnAt])
}

model ApplicationResumeSnapshot {
  id              String         @id @default(cuid())
  organisationId  String
  applicationId   String         @unique
  resumeAssetId   String?
  storageKey      String
  storageProvider String
  filename        String
  mimeType        String
  sizeBytes       Int
  createdAt       DateTime       @default(now())
  organisation    Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  application     JobApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  resumeAsset     ResumeAsset?   @relation(fields: [resumeAssetId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
}

model ApplicationScreeningAnswer {
  id                    String                @id @default(cuid())
  organisationId        String
  applicationId         String
  originalQuestionId    String?
  fileAssetId           String?
  questionTextSnapshot  String
  internalLabelSnapshot String?
  helpTextSnapshot      String?
  placeholderSnapshot   String?
  questionTypeSnapshot  ScreeningQuestionType
  optionsSnapshot       Json?
  validationSnapshot    Json?
  requiredSnapshot      Boolean
  answerValue           Json?
  screeningOutcome      ScreeningOutcome?
  createdAt             DateTime              @default(now())
  organisation          Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  application           JobApplication        @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  originalQuestion      JobScreeningQuestion? @relation(fields: [originalQuestionId], references: [id], onDelete: SetNull)
  fileAsset             ResumeAsset?          @relation("ScreeningAnswerFileAsset", fields: [fileAssetId], references: [id], onDelete: SetNull)

  @@index([organisationId, applicationId])
  @@index([applicationId, originalQuestionId])
}

model ApplicationFlag {
  id             String                 @id @default(cuid())
  organisationId String
  applicationId  String
  questionId     String?
  outcome        ScreeningOutcome
  operator       ScreeningRuleOperator?
  internalReason String
  metadata       Json?
  resolvedAt     DateTime?
  createdAt      DateTime               @default(now())
  organisation   Organisation           @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  application    JobApplication         @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  question       JobScreeningQuestion?  @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([applicationId, createdAt])
  @@index([outcome, createdAt])
}

model ApplicationTimeline {
  id                 String         @id @default(cuid())
  organisationId     String
  applicationId      String
  actorUserId        String?
  eventType          String
  message            String
  metadata           Json?
  isCandidateVisible Boolean        @default(true)
  createdAt          DateTime       @default(now())
  organisation       Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  application        JobApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([organisationId, applicationId, createdAt])
  @@index([applicationId, isCandidateVisible, createdAt])
}

model CandidateJobView {
  id                     String           @id @default(cuid())
  candidateId            String
  jobId                  String
  source                 String?
  referrerClassification String?
  firstViewedAt          DateTime         @default(now())
  lastViewedAt           DateTime         @default(now())
  viewCount              Int              @default(1)
  candidate              CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job                    Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobId])
  @@index([candidateId, lastViewedAt])
  @@index([jobId])
}

model CandidateActivity {
  id            String                @id @default(cuid())
  candidateId   String
  userId        String?
  applicationId String?
  jobId         String?
  type          CandidateActivityType
  metadata      Json?
  createdAt     DateTime              @default(now())
  candidate     CandidateProfile      @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt])
  @@index([type, createdAt])
}

model AtsNote {
  id             String        @id @default(cuid())
  organisationId String?
  applicationId  String
  authorId       String
  content        String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  application    Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author         User          @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([organisationId, applicationId])
}

model ApplicationActivity {
  id             String        @id @default(cuid())
  organisationId String?
  applicationId  String
  actorUserId    String?
  eventType      String?
  message        String
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  application    Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorUser      User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, applicationId, createdAt])
  @@index([actorUserId, createdAt])
}

model ResumeBuilder {
  id             String           @id @default(cuid())
  candidateId    String           @unique
  template       String           @default("classic")
  personal       Json
  education      Json
  experience     Json
  skills         Json
  projects       Json
  completedScore Int              @default(0)
  updatedAt      DateTime         @updatedAt
  candidate      CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model SavedCandidate {
  id             String           @id @default(cuid())
  organisationId String?
  recruiterId    String
  candidateId    String
  tag            CandidateTag?
  createdAt      DateTime         @default(now())
  organisation   Organisation?    @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  recruiter      RecruiterProfile @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  candidate      CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([recruiterId, candidateId])
  @@index([organisationId, candidateId])
}

model RecruiterSavedSearch {
  id             String                   @id @default(cuid())
  organisationId String
  recruiterId    String
  label          String
  query          Json
  type           RecruiterSavedSearchType @default(SAVED)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  organisation   Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  recruiter      RecruiterProfile         @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@index([organisationId, type, updatedAt])
  @@index([recruiterId, type, updatedAt])
}

model TalentPool {
  id                  String                @id @default(cuid())
  organisationId      String
  createdByRecruiterId String
  name                String
  description         String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  organisation        Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdByRecruiter  RecruiterProfile      @relation(fields: [createdByRecruiterId], references: [id], onDelete: Cascade)
  candidates          TalentPoolCandidate[]

  @@unique([organisationId, name])
  @@index([organisationId, updatedAt])
}

model TalentPoolCandidate {
  id            String           @id @default(cuid())
  talentPoolId  String
  candidateId   String
  createdAt     DateTime         @default(now())
  talentPool    TalentPool       @relation(fields: [talentPoolId], references: [id], onDelete: Cascade)
  candidate     CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([talentPoolId, candidateId])
  @@index([candidateId, createdAt])
}

model JobRequisition {
  id               String              @id @default(cuid())
  organisationId   String
  requisitionCode  String
  title            String
  department       String?
  businessUnit     String?
  location         String?
  employmentType   EmploymentType?
  numberOfOpenings Int                 @default(1)
  hiringManagerId  String?
  recruiterId      String?
  priority         RequisitionPriority @default(MEDIUM)
  targetHireDate   DateTime?
  status           RequisitionStatus   @default(DRAFT)
  reasonForHiring  String?
  replacementFor   String?
  budgetMin        Int?
  budgetMax        Int?
  currency         String?
  approvalStatus   ApprovalStatus      @default(NOT_REQUIRED)
  approvedById     String?
  approvedAt       DateTime?
  createdById      String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  organisation     Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  approvedBy       User?               @relation("RequisitionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  createdBy        User                @relation("RequisitionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  hiringManager    User?               @relation("RequisitionHiringManager", fields: [hiringManagerId], references: [id], onDelete: SetNull)
  recruiter        User?               @relation("RequisitionRecruiter", fields: [recruiterId], references: [id], onDelete: SetNull)
  jobs             Job[]

  @@unique([organisationId, requisitionCode])
  @@index([organisationId, status, priority])
  @@index([organisationId, approvalStatus])
}

model InterviewProcess {
  id             String           @id @default(cuid())
  organisationId String
  applicationId  String
  title          String
  status         InterviewStatus  @default(PLANNED)
  createdById    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  application    Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdBy      User             @relation("InterviewPlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  rounds         InterviewRound[]

  @@index([organisationId, applicationId])
}

model InterviewRound {
  id                 String                 @id @default(cuid())
  organisationId     String
  interviewProcessId String
  roundName          String
  sequence           Int
  interviewType      InterviewType
  status             InterviewStatus        @default(PLANNED)
  scheduledStartAt   DateTime?
  scheduledEndAt     DateTime?
  meetingLocation    String?
  meetingLink        String?
  cancelReason       String?
  scorecardCriteria  Json?
  feedbackLockedAt   DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  organisation       Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  interviewProcess   InterviewProcess       @relation(fields: [interviewProcessId], references: [id], onDelete: Cascade)
  panelMembers       InterviewPanelMember[]
  feedbacks          InterviewFeedback[]

  @@unique([interviewProcessId, sequence])
  @@index([organisationId, status])
}

model InterviewPanelMember {
  id               String         @id @default(cuid())
  organisationId   String
  interviewRoundId String
  userId           String
  createdAt        DateTime       @default(now())
  organisation     Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  interviewRound   InterviewRound @relation(fields: [interviewRoundId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([interviewRoundId, userId])
  @@index([organisationId, userId])
}

model InterviewFeedback {
  id               String                  @id @default(cuid())
  organisationId   String
  interviewRoundId String
  interviewerId    String
  submittedAt      DateTime?
  recommendation   FeedbackRecommendation?
  overallScore     Int?
  comments         String?
  criteriaScores   Json?
  finalizedAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  organisation     Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  interviewRound   InterviewRound          @relation(fields: [interviewRoundId], references: [id], onDelete: Cascade)
  interviewer      User                    @relation("InterviewFeedbackAuthor", fields: [interviewerId], references: [id], onDelete: Cascade)

  @@unique([interviewRoundId, interviewerId])
  @@index([organisationId, interviewerId, submittedAt])
}

model Notification {
  id              String           @id @default(cuid())
  organisationId  String?
  recipientUserId String
  type            NotificationType
  title           String
  message         String
  entityType      String?
  entityId        String?
  metadata        Json?
  readAt          DateTime?
  createdAt       DateTime         @default(now())
  organisation    Organisation?    @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  recipientUser   User             @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, readAt, createdAt])
  @@index([organisationId, recipientUserId])
}

model AuditLog {
  id             String        @id @default(cuid())
  organisationId String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  beforeData     Json?
  afterData      Json?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  actorUser      User?         @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}

model AuthToken {
  id         String        @id @default(cuid())
  userId     String?
  type       AuthTokenType
  tokenHash  String        @unique
  context    Json?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime      @default(now())
  user       User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}
