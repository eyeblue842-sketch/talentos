  name                        String
  slug                        String                       @unique
  status                      OrganisationStatus           @default(ACTIVE)
  website                     String?
  logoUrl                     String?
  publicDescription           String?
  industry                    String?
  organisationSize            String?
  headquarters                String?
  publicLocations             String[]                     @default([])
  cultureSummary              String?
  benefitsSummary             String?
  careersEnabled              Boolean                      @default(true)
  onboardingCompletedAt       DateTime?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  recruiterProfiles           RecruiterProfile[]
  memberships                 OrganisationMembership[]
  jobs                        Job[]
  applications                Application[]
  notes                       AtsNote[]
  activities                  ApplicationActivity[]
  savedCandidates             SavedCandidate[]
  recruiterSavedSearches      RecruiterSavedSearch[]
  talentPools                 TalentPool[]
  requisitions                JobRequisition[]
  interviewPlans              InterviewProcess[]
  interviewRounds             InterviewRound[]
  interviewPanels             InterviewPanelMember[]
  interviewFeedbacks          InterviewFeedback[]
  meetingProviderConnections  MeetingProviderConnection[]
  interviewMeetings           InterviewMeeting[]
  meetingParticipants         MeetingParticipant[]
  rescheduleRequests          InterviewRescheduleRequest[]
  rescheduleHistory           InterviewScheduleHistory[]
  meetingReminders            MeetingReminder[]
  notifications               Notification[]
  auditLogs                   AuditLog[]
  screeningQuestionTemplates  ScreeningQuestionTemplate[]
  jobScreeningQuestions       JobScreeningQuestion[]
  applicationsSubmitted       JobApplication[]
  applicationFlags            ApplicationFlag[]
  applicationAnswers          ApplicationScreeningAnswer[]
  applicationResumeSnapshots  ApplicationResumeSnapshot[]
  applicationTimelines        ApplicationTimeline[]
  invitations                 OrganisationInvitation[]
  offers                      Offer[]
  units                       OrganisationUnit[]
  settings                    OrganisationSettings?
  roleDefinitions             OrganisationRoleDefinition[]
  notificationTemplates       NotificationTemplate[]
  featureFlags                FeatureFlag[]
  intelligenceExecutions      IntelligenceExecution[]
  intelligenceResults         IntelligenceResult[]
  candidateIntelligenceStates CandidateIntelligenceState[]
  candidateJobMatchStates     CandidateJobMatchState[]
  candidateRankingSnapshots   CandidateRankingSnapshot[]
  candidateRankingEntries     CandidateRankingEntry[]
