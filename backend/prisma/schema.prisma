model User {
  id                                    String                          @id @default(cuid())
  email                                 String                          @unique
  passwordHash                          String
  name                                  String?
  phoneNumber                           String?
  role                                  UserRole
  isActive                              Boolean                         @default(true)
  accountStatus                         UserAccountStatus               @default(ACTIVE)
  sessionVersion                        Int                             @default(0)
  mustChangePassword                    Boolean                         @default(false)
  emailVerifiedAt                       DateTime?
  lastLoginAt                           DateTime?
  mfaEnabled                            Boolean                         @default(false)
  createdAt                             DateTime                        @default(now())
  updatedAt                             DateTime                        @updatedAt
  recruiterProfile                      RecruiterProfile?
  candidateProfile                      CandidateProfile?
  jobs                                  Job[]                           @relation("PostedJobs")
  notes                                 AtsNote[]                       @relation("NoteAuthor")
  applicationActivities                 ApplicationActivity[]
  authTokens                            AuthToken[]
  memberships                           OrganisationMembership[]
  createdRequisitions                   JobRequisition[]                @relation("RequisitionCreatedBy")
  approvedRequisitions                  JobRequisition[]                @relation("RequisitionApprovedBy")
  managedRequisitions                   JobRequisition[]                @relation("RequisitionHiringManager")
  recruitedRequisitions                 JobRequisition[]                @relation("RequisitionRecruiter")
  managedJobs                           Job[]                           @relation("JobHiringManager")
  interviewPlanCreators                 InterviewProcess[]              @relation("InterviewPlanCreatedBy")
  ownedInterviewRounds                  InterviewRound[]                @relation("InterviewRoundOwner")
  interviewPanelMemberships             InterviewPanelMember[]
  interviewFeedbacks                    InterviewFeedback[]             @relation("InterviewFeedbackAuthor")
  meetingProviderConnections            MeetingProviderConnection[]     @relation("MeetingProviderConnectedBy")
  interviewMeetingsCreated              InterviewMeeting[]              @relation("InterviewMeetingCreatedBy")
  interviewMeetingsUpdated              InterviewMeeting[]              @relation("InterviewMeetingUpdatedBy")
  meetingParticipants                   MeetingParticipant[]
  meetingRescheduleRequests             InterviewRescheduleRequest[]    @relation("InterviewRescheduleRequestedBy")
  meetingRescheduleReviews              InterviewRescheduleRequest[]    @relation("InterviewRescheduleReviewedBy")
  meetingScheduleHistory                InterviewScheduleHistory[]      @relation("InterviewScheduleHistoryActor")
  notifications                         Notification[]                  @relation("NotificationRecipient")
  auditLogs                             AuditLog[]                      @relation("AuditLogActor")
  screeningQuestionTemplates            ScreeningQuestionTemplate[]     @relation("ScreeningQuestionTemplateAuthor")
  jobScreeningQuestions                 JobScreeningQuestion[]          @relation("JobScreeningQuestionAuthor")
  resumeAssets                          ResumeAsset[]                   @relation("ResumeAssetOwner")
  sentOrganisationInvites               OrganisationInvitation[]        @relation("OrganisationInvitationInvitedBy")
  acceptedOrganisationInvites           OrganisationInvitation[]        @relation("OrganisationInvitationAcceptedBy")
  createdOffers                         Offer[]                         @relation("OfferCreatedBy")
  updatedOffers                         Offer[]                         @relation("OfferUpdatedBy")
  releasedOffers                        Offer[]                         @relation("OfferReleasedBy")
  offerApprovals                        OfferApproval[]                 @relation("OfferApprover")
  offerComments                         OfferComment[]                  @relation("OfferCommentAuthor")
  createdRoleDefinitions                OrganisationRoleDefinition[]    @relation("RoleDefinitionCreatedBy")
  updatedRoleDefinitions                OrganisationRoleDefinition[]    @relation("RoleDefinitionUpdatedBy")
  updatedNotificationTemplates          NotificationTemplate[]          @relation("NotificationTemplateUpdatedBy")
  updatedFeatureFlags                   FeatureFlag[]                   @relation("FeatureFlagUpdatedBy")
  updatedOrganisationSettings           OrganisationSettings[]          @relation("OrganisationSettingsUpdatedBy")
  requestedIntelligenceExecutions       IntelligenceExecution[]         @relation("IntelligenceExecutionRequestedBy")
  intelligenceFeedbacks                 IntelligenceFeedback[]
  backgroundTasksCreated                BackgroundTask[]                @relation("BackgroundTaskCreatedBy")
  backgroundTasksUpdated                BackgroundTask[]                @relation("BackgroundTaskUpdatedBy")
  createdResumeImportBatches            ResumeImportBatch[]             @relation("ResumeImportBatchCreatedBy")
  importedCandidates                    CandidateProfile[]              @relation("CandidateProfileImportedBy")
  resolvedResumeImportItems             ResumeImportItem[]              @relation("ResumeImportItemResolvedBy")
  completedPlatformSetupStates          PlatformSetupState[]            @relation("PlatformSetupCompletedBy")
  resetPlatformSetupStates              PlatformSetupState[]            @relation("PlatformSetupResetBy")
  createdJobDescriptionDrafts           JobDescriptionDraft[]           @relation("JobDescriptionDraftCreatedBy")
  updatedJobDescriptionDrafts           JobDescriptionDraft[]           @relation("JobDescriptionDraftUpdatedBy")
  approvedJobDescriptionDrafts          JobDescriptionDraft[]           @relation("JobDescriptionDraftApprovedBy")
  appliedJobDescriptionDrafts           JobDescriptionDraft[]           @relation("JobDescriptionDraftAppliedBy")
  createdJobDescriptionTemplates        JobDescriptionTemplate[]        @relation("JobDescriptionTemplateCreatedBy")
  updatedJobDescriptionTemplates        JobDescriptionTemplate[]        @relation("JobDescriptionTemplateUpdatedBy")
  activatedJobDescriptionTemplates      JobDescriptionTemplate[]        @relation("JobDescriptionTemplateActivatedBy")
  createdJobDescriptionTemplateVersions JobDescriptionTemplateVersion[] @relation("JobDescriptionTemplateVersionCreatedBy")
  createdMatchScoringProfiles           MatchScoringProfile[]           @relation("MatchScoringProfileCreatedBy")
  updatedMatchScoringProfiles           MatchScoringProfile[]           @relation("MatchScoringProfileUpdatedBy")
  activatedMatchScoringProfiles         MatchScoringProfile[]           @relation("MatchScoringProfileActivatedBy")
  createdMatchScoringProfileVersions    MatchScoringProfileVersion[]    @relation("MatchScoringProfileVersionCreatedBy")
  createdRecruiterMatchOverrides        RecruiterMatchOverride[]        @relation("RecruiterMatchOverrideCreatedBy")
  triggeredRankingSnapshots             CandidateRankingSnapshot[]      @relation("CandidateRankingSnapshotTriggeredBy")
  semanticSearchQueries                 SemanticSearchQuery[]           @relation("SemanticSearchQueryCreatedBy")
  semanticSearchExecutions              SemanticSearchExecution[]       @relation("SemanticSearchExecutionCreatedBy")
  ownedSavedCandidateSearches           SavedCandidateSearch[]          @relation("SavedCandidateSearchOwner")
  sentConnections                       UserConnection[]                @relation("UserConnectionRequester")
  receivedConnections                   UserConnection[]                @relation("UserConnectionReceiver")
  networkPrivacySettings                NetworkPrivacySettings?
  blockedUsers                          UserBlock[]                     @relation("UserBlockBlocker")
  blockedByUsers                        UserBlock[]                     @relation("UserBlockBlocked")
  companyFollows                        CompanyFollow[]
  directConversationsA                  DirectConversation[]            @relation("DirectConversationParticipantA")
  directConversationsB                  DirectConversation[]            @relation("DirectConversationParticipantB")
  directMessagesSent                    DirectMessage[]                 @relation("DirectMessageSender")
}

model Organisation {
