generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  RECRUITER
  CANDIDATE
  ADMIN
  // Portal-scoped admin roles: CANDIDATE_ADMIN behaves as a normal candidate
  // everywhere (no elevated access exists to grant yet - reserved for future
  // candidate-portal-only admin surfaces). RECRUITER_ADMIN gets the existing
  // recruiter/organisation admin panel scoped to its own organisation, same as
  // any recruiter OWNER. PLATFORM_ADMIN is an explicit opt-in equivalent of the
  // legacy org-agnostic ADMIN platform bypass, for optional system-wide access.
  CANDIDATE_ADMIN
  RECRUITER_ADMIN
  PLATFORM_ADMIN
}

