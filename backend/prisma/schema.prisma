model NetworkPrivacySettings {
  id                          String                      @id @default(cuid())
  userId                      String                      @unique
  allowConnectionRequestsFrom ConnectionRequestPermission @default(EVERYONE)
  connectionVisibility        ConnectionVisibility        @default(CONNECTIONS_ONLY)
  showInPeopleSearch          Boolean                     @default(true)
  showRecruiterIdentity       Boolean                     @default(true)
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  user                        User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([showInPeopleSearch])
}

model UserConnection {
  id              String           @id @default(cuid())
  requesterUserId String
  receiverUserId  String
  pairKey         String           @unique
  status          ConnectionStatus @default(PENDING)
  source          ConnectionSource @default(PROFILE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  acceptedAt      DateTime?
  requesterUser   User             @relation("UserConnectionRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  receiverUser    User             @relation("UserConnectionReceiver", fields: [receiverUserId], references: [id], onDelete: Cascade)

  @@index([requesterUserId, status, createdAt])
  @@index([receiverUserId, status, createdAt])
  @@index([status, acceptedAt])
}

model UserBlock {
  id            String   @id @default(cuid())
  blockerUserId String
  blockedUserId String
  createdAt     DateTime @default(now())
  blockerUser   User     @relation("UserBlockBlocker", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blockedUser   User     @relation("UserBlockBlocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerUserId, blockedUserId])
  @@index([blockedUserId, blockerUserId])
}

model CompanyFollow {
  id             String       @id @default(cuid())
  userId         String
  organisationId String
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
  @@index([organisationId, createdAt])
}

model DirectConversation {
  id                      String          @id @default(cuid())
  participantAUserId      String
  participantBUserId      String
  pairKey                 String          @unique
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  lastMessageAt           DateTime?
  lastMessagePreview      String?
  participantALastReadAt  DateTime?
  participantBLastReadAt  DateTime?
  participantAUnreadCount Int             @default(0)
  participantBUnreadCount Int             @default(0)
  participantAUser        User            @relation("DirectConversationParticipantA", fields: [participantAUserId], references: [id], onDelete: Cascade)
  participantBUser        User            @relation("DirectConversationParticipantB", fields: [participantBUserId], references: [id], onDelete: Cascade)
  messages                DirectMessage[]

  @@index([participantAUserId, lastMessageAt(sort: Desc)])
  @@index([participantBUserId, lastMessageAt(sort: Desc)])
}

model DirectMessage {
  id                        String             @id @default(cuid())
  conversationId            String
  senderUserId              String
  type                      DirectMessageType  @default(TEXT)
  content                   String?
  attachmentOriginalName    String?
  attachmentStorageKey      String?
  attachmentStorageProvider String?
  attachmentMimeType        String?
  attachmentSizeBytes       Int?
  attachmentChecksumSha256  String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  editedAt                  DateTime?
  deletedAt                 DateTime?
  conversation              DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser                User               @relation("DirectMessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderUserId, createdAt(sort: Desc)])
  @@index([conversationId, deletedAt, createdAt(sort: Desc)])
}

model OrganisationMembership {
  id                     String                      @id @default(cuid())
  organisationId         String
  userId                 String
  role                   OrganisationRole
  status                 MembershipStatus            @default(ACTIVE)
  customRoleDefinitionId String?
  invitedById            String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  organisation           Organisation                @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user                   User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRoleDefinition   OrganisationRoleDefinition? @relation(fields: [customRoleDefinitionId], references: [id], onDelete: SetNull)

  @@unique([organisationId, userId])
  @@index([userId, status])
  @@index([organisationId, role, status])
  @@index([customRoleDefinitionId])
