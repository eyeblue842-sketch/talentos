model Offer {
  id                        String             @id @default(cuid())
  organisationId            String
  applicationId             String
  jobId                     String
  candidateId               String
  previousOfferId           String?
  supersededByOfferId       String?
  referenceNumber           String             @unique
  version                   Int
  status                    OfferStatus        @default(DRAFT)
  currency                  String
  annualCompensation        Decimal?           @db.Decimal(14, 2)
  fixedCompensation         Decimal?           @db.Decimal(14, 2)
  variableCompensation      Decimal?           @db.Decimal(14, 2)
  joiningBonus              Decimal?           @db.Decimal(14, 2)
  retentionBonus            Decimal?           @db.Decimal(14, 2)
  allowancesAmount          Decimal?           @db.Decimal(14, 2)
  otherCompensation         Decimal?           @db.Decimal(14, 2)
  totalCompensation         Decimal?           @db.Decimal(14, 2)
  benefitsSummary           String?
  compensationNotes         String?
  proposedJoiningDate       DateTime?
  actualJoiningDate         DateTime?
  probationPeriodMonths     Int?
  noticeOrBuyoutNote        String?
  workMode                  WorkplaceType?
  workLocation              String?
  reportingManagerName      String?
  departmentSnapshot        String?
  employmentTypeSnapshot    EmploymentType?
  recruiterNameSnapshot     String?
  hiringManagerNameSnapshot String?
  offerExpiryDays           Int?
  expiryAt                  DateTime?
  approvalRequestedAt       DateTime?
  approvedAt                DateTime?
  releasedAt                DateTime?
  viewedAt                  DateTime?
  acceptedAt                DateTime?
  rejectedAt                DateTime?
  withdrawnAt               DateTime?
  supersededAt              DateTime?
  joiningConfirmedAt        DateTime?
  deferredAt                DateTime?
  noShowAt                  DateTime?
  revisionReason            String?
  candidateResponseReason   String?
  withdrawalReason          String?
  deferredReason            String?
  noShowReason              String?
  termsAndConditions        String?
  internalNotes             String?
  createdByUserId           String
  updatedByUserId           String
  releasedByUserId          String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  organisation              Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  application               Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  job                       Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate                 CandidateProfile   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  previousOffer             Offer?             @relation("OfferRevisionChain", fields: [previousOfferId], references: [id], onDelete: SetNull)
  supersededByOffer         Offer?             @relation("OfferSupersededBy", fields: [supersededByOfferId], references: [id], onDelete: SetNull)
  revisionChildren          Offer[]            @relation("OfferRevisionChain")
  supersededOffers          Offer[]            @relation("OfferSupersededBy")
  createdBy                 User               @relation("OfferCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy                 User               @relation("OfferUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  releasedBy                User?              @relation("OfferReleasedBy", fields: [releasedByUserId], references: [id], onDelete: SetNull)
  components                OfferComponent[]
  approvals                 OfferApproval[]
  accessTokens              OfferAccessToken[]
  comments                  OfferComment[]

  @@unique([applicationId, version])
  @@index([organisationId, status, updatedAt])
  @@index([organisationId, expiryAt, status])
  @@index([candidateId, status, updatedAt])
  @@index([applicationId, status, version])
  @@index([jobId, status, updatedAt])
}

model OfferComponent {
