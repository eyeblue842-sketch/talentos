  encryptedHostUrl        String?
  passcodeMetadata        Json?
  timezone                String
  scheduledStartUtc       DateTime
  scheduledEndUtc         DateTime
  durationMinutes         Int
  location                String?
  officeAddress           String?
  dialInInformation       String?
  providerDisplayName     String?
  instructions            String?
  candidateInstructions   String?
  internalNotes           String?
  providerMetadata        Json?
  providerOperationKey    String?
  operationVersion        Int                          @default(1)
  rescheduleCount         Int                          @default(0)
  lastRescheduledAt       DateTime?
  providerLastSyncedAt    DateTime?
