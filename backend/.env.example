PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=false
JWT_SECRET=replace-with-a-long-secret
JWT_EXPIRES_IN=7d
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=careeriz_test
TEST_DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=careeriz_test
API_BODY_LIMIT_MB=5
FILE_UPLOAD_MAX_MB=5
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=15
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=careeriz
REDIS_CONNECT_TIMEOUT_MS=5000
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=resumes
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage/resumes
AWS_REGION=ap-south-1
AWS_S3_BUCKET=careeriz-resumes
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@careeriz.app
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/oauth/google/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/auth/oauth/linkedin/callback
RESUME_BUILDER_ENABLED=false
RESUME_BUILDER_BASE_URL=
RESUME_BUILDER_CLIENT_ID=
INTELLIGENCE_ENABLED=false
INTELLIGENCE_PROVIDER=DISABLED
INTELLIGENCE_MODEL=
INTELLIGENCE_API_KEY=
INTELLIGENCE_BASE_URL=
INTELLIGENCE_TIMEOUT_MS=20000
INTELLIGENCE_MAX_RETRIES=1
INTELLIGENCE_MAX_INPUT_CHARS=30000
INTELLIGENCE_MAX_OUTPUT_TOKENS=1200
WORKER_CONCURRENCY=3
WORKER_POLL_INTERVAL_MS=5000
WORKER_SCHEDULER_INTERVAL_MS=30000
TASK_RETENTION_DAYS=30
