PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:5000
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=false
JWT_SECRET=replace-with-a-long-32-character-secret
JWT_EXPIRES_IN=12h
DATABASE_URL=postgresql://careeriz:careeriz@localhost:5432/careeriz?schema=public
DIRECT_URL=postgresql://careeriz:careeriz@localhost:5432/careeriz?schema=public
API_BODY_LIMIT_MB=5
FILE_UPLOAD_MAX_MB=5
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=15
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=careeriz
REDIS_CONNECT_TIMEOUT_MS=5000
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=resumes
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage/resumes
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
QUEUE_PROVIDER=database
AWS_SQS_RESUME_IMPORT_QUEUE_URL=
AWS_SQS_RESUME_IMPORT_DLQ_URL=
RESUME_IMPORT_WORKER_CONCURRENCY=1
RESUME_IMPORT_MAX_RETRIES=3
RESUME_IMPORT_MAX_FILES=100
RESUME_MAX_FILE_SIZE_MB=10
RESUME_IMPORT_MAX_ZIP_SIZE_MB=100
RESUME_IMPORT_MAX_UNCOMPRESSED_MB=500
RESUME_IMPORT_MAX_TEXT_CHARS=120000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@careeriz.app
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback
GOOGLE_MEETING_ENABLED=false
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5000/api/meeting-providers/callback/GOOGLE_MEET
ZOOM_MEETING_ENABLED=false
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_OAUTH_REDIRECT_URI=http://127.0.0.1:5000/api/meeting-providers/callback/ZOOM
CUSTOM_MEETING_ENABLED=true
PUBLIC_APP_URL=http://localhost:3000
MEETING_TOKEN_ENCRYPTION_KEY=
RESUME_BUILDER_ENABLED=false
RESUME_BUILDER_BASE_URL=
RESUME_BUILDER_CLIENT_ID=
INTELLIGENCE_ENABLED=false
INTELLIGENCE_PROVIDER=DISABLED
INTELLIGENCE_MODEL=
INTELLIGENCE_API_KEY=
INTELLIGENCE_BASE_URL=
INTELLIGENCE_TIMEOUT_MS=30000
INTELLIGENCE_MAX_RETRIES=1
INTELLIGENCE_MAX_INPUT_CHARS=30000
INTELLIGENCE_MAX_OUTPUT_TOKENS=1200
AI_PROVIDER=disabled
AI_RESUME_PARSING_ENABLED=false
AWS_BEDROCK_REGION=
AWS_BEDROCK_MODEL_ID=
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
# WORKER_CONCURRENCY governs the general background-task loop; keep it at 1
# for reliable, debuggable local/staging runs. RESUME_IMPORT_WORKER_CONCURRENCY
# independently caps how many RESUME_IMPORT_PROCESSING tasks may be claimed in
# the same poll cycle, so raising WORKER_CONCURRENCY for other task types (e.g.
# reminders) in production cannot accidentally parallelise resume processing.
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_MS=5000
WORKER_SCHEDULER_INTERVAL_MS=30000
TASK_RETENTION_DAYS=30
# How long a claimed task's lease lasts before it's considered abandoned and
# recovered by the scheduler sweep (crashed/killed worker protection).
TASK_LEASE_DURATION_MS=300000
# How often a running worker process writes its heartbeat row.
WORKER_HEARTBEAT_INTERVAL_MS=10000
# How long since the last heartbeat before the worker is reported offline.
WORKER_HEARTBEAT_STALE_MS=45000

# Document-processing service (Track B, Step 3). Disabled by default: no
# resume-import behavior changes until an engine (Docling/PaddleOCR) is
# actually wired into the pipeline in a later step. See document-processor/
# for the service itself.
DOCUMENT_PROCESSOR_ENABLED=false
DOCUMENT_PROCESSOR_URL=http://127.0.0.1:8081
DOCUMENT_PROCESSOR_CONNECT_TIMEOUT_MS=3000
DOCUMENT_PROCESSOR_RESPONSE_TIMEOUT_MS=120000
DOCUMENT_PROCESSOR_MAX_RETRIES=1
DOCUMENT_PROCESSOR_CIRCUIT_BREAKER_THRESHOLD=5
DOCUMENT_PROCESSOR_CIRCUIT_BREAKER_COOLDOWN_MS=30000
