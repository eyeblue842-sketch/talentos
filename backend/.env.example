PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
JWT_SECRET=replace-with-a-long-secret
JWT_EXPIRES_IN=7d
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=careeriz_test
TEST_DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=careeriz_test
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=resumes
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage/resumes
AWS_REGION=ap-south-1
AWS_S3_BUCKET=careeriz-resumes
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@careeriz.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/oauth/google/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/auth/oauth/linkedin/callback
