ZOOM_MEETING_ENABLED=false
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_OAUTH_REDIRECT_URI=http://127.0.0.1:5000/api/meeting-providers/callback/ZOOM
CUSTOM_MEETING_ENABLED=true
PUBLIC_APP_URL=http://localhost:3000
MEETING_TOKEN_ENCRYPTION_KEY=
RESUME_BUILDER_ENABLED=false
RESUME_BUILDER_BASE_URL=
RESUME_BUILDER_CLIENT_ID=
INTELLIGENCE_ENABLED=false
INTELLIGENCE_PROVIDER=DISABLED
INTELLIGENCE_MODEL=
INTELLIGENCE_API_KEY=
INTELLIGENCE_BASE_URL=
INTELLIGENCE_TIMEOUT_MS=30000
INTELLIGENCE_MAX_RETRIES=1
INTELLIGENCE_MAX_INPUT_CHARS=30000
INTELLIGENCE_MAX_OUTPUT_TOKENS=1200
AI_PROVIDER=disabled
AI_RESUME_PARSING_ENABLED=false
AWS_BEDROCK_REGION=
AWS_BEDROCK_MODEL_ID=
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
# WORKER_CONCURRENCY governs the general background-task loop; keep it at 1
# for reliable, debuggable local/staging runs. RESUME_IMPORT_WORKER_CONCURRENCY
# independently caps how many RESUME_IMPORT_PROCESSING tasks may be claimed in
# the same poll cycle, so raising WORKER_CONCURRENCY for other task types (e.g.
# reminders) in production cannot accidentally parallelise resume processing.
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_MS=5000
WORKER_SCHEDULER_INTERVAL_MS=30000
TASK_RETENTION_DAYS=30
# How long a claimed task's lease lasts before it's considered abandoned and
# recovered by the scheduler sweep (crashed/killed worker protection).
TASK_LEASE_DURATION_MS=300000
# How often a running worker process writes its heartbeat row.
WORKER_HEARTBEAT_INTERVAL_MS=10000
# How long since the last heartbeat before the worker is reported offline.
WORKER_HEARTBEAT_STALE_MS=45000

# Document-processing service (Track B, Step 3). Disabled by default: no
# resume-import behavior changes until an engine (Docling/PaddleOCR) is
# actually wired into the pipeline in a later step. See document-processor/
# for the service itself.
DOCUMENT_PROCESSOR_ENABLED=false
DOCUMENT_PROCESSOR_URL=http://127.0.0.1:8081
DOCUMENT_PROCESSOR_CONNECT_TIMEOUT_MS=3000
DOCUMENT_PROCESSOR_RESPONSE_TIMEOUT_MS=120000
DOCUMENT_PROCESSOR_MAX_RETRIES=1
DOCUMENT_PROCESSOR_CIRCUIT_BREAKER_THRESHOLD=5
DOCUMENT_PROCESSOR_CIRCUIT_BREAKER_COOLDOWN_MS=30000

# Subscriptions, Billing, Job Credits and Payment Gateway
# (feature/subscriptions-billing-entitlements). Use Razorpay TEST MODE
# credentials only (rzp_test_... / a test webhook secret from the Razorpay
# Dashboard, Test Mode). Never put live keys here. RAZORPAY_ENABLED must be
# explicitly set to true, with KEY_ID/KEY_SECRET/WEBHOOK_SECRET all present,
# before checkout/webhook endpoints will do anything other than return
# PAYMENT_PROVIDER_DISABLED.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Public Razorpay Payment Button ids from the pricing cards (display/
# reference only - these do NOT grant entitlements, see billingService.js
# and the Stage 1 design report for why).
RAZORPAY_BUTTON_JOB_POST_45D=pl_TPVXsxktdDidfS
RAZORPAY_BUTTON_ATS_DB_1M=pl_TPVgVPvR7G7Beb
RAZORPAY_BUTTON_ATS_DB_6M=pl_TPVkpCpO9OPsfg
RAZORPAY_BUTTON_ATS_DB_12M=pl_TPVnJODtcPseGf
# Careeriz's own registered GST home-state code (2 digits) - required to
# correctly split GST into CGST+SGST vs IGST on generated invoices. Leave
# unset in development; invoices generated without it are flagged
# placeOfSupplyAssumed:true (see Invoice model / CAREERIZ billing docs).
BILLING_SELLER_STATE_CODE=
BILLING_SELLER_LEGAL_NAME=Careeriz
BILLING_SELLER_GSTIN=
BILLING_PURCHASED_CREDIT_VALIDITY_MONTHS=12
BILLING_RENEWAL_REMINDER_DAYS_BEFORE=15
