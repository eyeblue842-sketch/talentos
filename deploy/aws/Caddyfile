careeriz.com {
	redir https://www.careeriz.com{uri} permanent
}

www.careeriz.com {
	encode gzip
	route {
		# TEMPORARY: first-run setup is restricted to the owner's IP until it has been
		# completed (the wizard is public by design). Remove this block afterwards.
		@setupBlocked {
			path /setup /setup/* /api/setup /api/setup/*
			not remote_ip 49.37.241.31
		}
		respond @setupBlocked "Careeriz is being set up. Please check back soon." 503

		# Setup API + callbacks LinkedIn/Google hit directly go to the API.
		@api path /api/setup /api/setup/* /api/auth/oauth/* /api/social/linkedin/callback
		reverse_proxy @api backend:5000

		reverse_proxy frontend:3000
	}
}
