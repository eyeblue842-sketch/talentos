careeriz.com {
	redir https://www.careeriz.com{uri} permanent
}

www.careeriz.com {
	log {
		output file /data/access.log {
			roll_size 5MiB
			roll_keep 3
		}
		format filter {
			request>uri query {
				replace token REDACTED
				replace code REDACTED
			}
			request>headers delete
			resp_headers delete
		}
	}
	encode gzip
	route {
		# Setup API + callbacks LinkedIn/Google hit directly go to the API.
		@api path /api/setup /api/setup/* /api/auth/oauth/* /api/social/linkedin/callback
		reverse_proxy @api backend:5000

		reverse_proxy frontend:3000
	}
}
