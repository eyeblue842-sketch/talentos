careeriz.com {
	redir https://www.careeriz.com{uri} permanent
}

www.careeriz.com {
	encode gzip
	route {
		# Setup API + callbacks LinkedIn/Google hit directly go to the API.
		@api path /api/setup /api/setup/* /api/auth/oauth/* /api/social/linkedin/callback
		reverse_proxy @api backend:5000

		reverse_proxy frontend:3000
	}
}
