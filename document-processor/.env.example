PORT=8081
MAX_CONCURRENT_REQUESTS=2
MAX_FILE_SIZE_MB=15
MAX_PAGE_COUNT=50
MAX_PIXEL_DIMENSION=6000
MAX_DECOMPRESSED_PIXELS=40000000
REQUEST_TIMEOUT_SECONDS=60
DOCLING_ENABLED=false
PADDLEOCR_ENABLED=false
PREPROCESSING_ENABLED=false
GPU_ENABLED=false
LOG_LEVEL=INFO

# Docling worker pool (Step 4.5)
DOCLING_CONVERSION_TIMEOUT_SECONDS=45
DOCLING_QUEUE_CAPACITY=1
DOCLING_WORKER_MAX_DOCUMENTS=50
DOCLING_WORKER_MAX_RSS_MB=2200
DOCLING_WARMUP_TIMEOUT_SECONDS=150

# Preprocessing (Step 5)
PREPROCESSING_RENDER_DPI=200
PREPROCESSING_MAX_RENDERED_PIXELS_PER_DOCUMENT=100000000
PREPROCESSING_MAX_TEMP_DISK_MB=500
PREPROCESSING_ABANDONED_DIR_MAX_AGE_MINUTES=60

# OCR worker pool (Step 6) -- separate pool/process from Docling's, hosts
# both preprocessing and PaddleOCR. See docs/document-processor.md for
# the (provisional, unmeasured -- see the Step 6 dependency-gate section)
# resource-limit rationale.
OCR_CONVERSION_TIMEOUT_SECONDS=60
OCR_QUEUE_CAPACITY=1
OCR_WORKER_MAX_DOCUMENTS=50
OCR_WORKER_MAX_RSS_MB=1800
OCR_WARMUP_TIMEOUT_SECONDS=300
OCR_LANGUAGE=en
OCR_MIN_CONFIDENCE=0.5
OCR_ORIENTATION_CONFIDENCE_THRESHOLD=0.85
OCR_MAX_PAGES_PER_DOCUMENT=30
# Optional: pre-baked/bind-mounted PaddleX model cache directory. Unset
# falls through to PaddleX's own default cache location.
PADDLEOCR_MODEL_DIR=
